# Porta HTTP do switchboard
PORT=8080

# Segredo usado para assinar as sessões (troque por um valor aleatório longo)
SESSION_SECRET=troque-este-segredo

# Conexão AMI do Issabel (/etc/asterisk/manager_custom.conf)
AMI_HOST=192.168.0.10
AMI_PORT=5038
AMI_USER=switchboard
AMI_SECRET=senha-ami

# Tecnologia dos ramais: SIP (chan_sip) ou PJSIP
CHANNEL_TECH=SIP
# Contexto usado para discar o número de destino no click-to-call
DIAL_CONTEXT=from-internal
# Contexto dos hints dos ramais no Issabel
HINT_CONTEXT=ext-local

# Banco de CDR do Issabel (aba Histórico)
CDR_DB_HOST=192.168.0.10
CDR_DB_PORT=3306
CDR_DB_USER=switchboard
CDR_DB_PASSWORD=senha-cdr
CDR_DB_NAME=asteriskcdrdb
CDR_DB_TABLE=cdr

# Administrador criado no primeiro start (se não houver usuários)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 1 = simula um PABX (para demonstração/testes sem Issabel)
MOCK_PBX=0
