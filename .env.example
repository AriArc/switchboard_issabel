# Porta HTTP do switchboard
PORT=8080
# 127.0.0.1 = acessível só pelo Apache (HTTPS) da própria VPS; 0.0.0.0 = acesso direto pela porta acima
HOST=127.0.0.1

# Segredo usado para assinar as sessões (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-este-segredo

# Conexão AMI do Issabel — mesma VPS, então sempre 127.0.0.1
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=switchboard
AMI_SECRET=senha-ami

# Tecnologia dos ramais: PJSIP (padrão do Issabel 5) ou SIP (chan_sip)
CHANNEL_TECH=PJSIP
# Contexto usado para discar o número de destino no click-to-call
DIAL_CONTEXT=from-internal
# Contexto dos hints dos ramais no Issabel
HINT_CONTEXT=ext-local

# Banco de CDR do Issabel (aba Histórico) — mesma VPS, então 127.0.0.1
CDR_DB_HOST=127.0.0.1
CDR_DB_PORT=3306
CDR_DB_USER=switchboard
CDR_DB_PASSWORD=senha-cdr
CDR_DB_NAME=asteriskcdrdb
CDR_DB_TABLE=cdr
# Alternativa ao TCP: conectar pelo socket local do MariaDB
# CDR_DB_SOCKET=/var/lib/mysql/mysql.sock

# Administrador criado no primeiro start (se não houver usuários)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 1 = simula um PABX (para demonstração/testes sem Issabel)
MOCK_PBX=0
